# ============================================================================
# EL RINCÓN DEL GATO — Variables de Entorno
# Copiar este archivo como .env y completar los valores
# ============================================================================

# --- Base de Datos MySQL ---
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=root
BD_CLAVE=
BD_NOMBRE=rincon_del_gato

# --- Ticketera Epson TM-T20III (Ethernet) ---
# Dejar vacío si no se tiene la ticketera conectada aún.
# El sistema funcionará normalmente sin ella.
TICKETERA_IP=
TICKETERA_PUERTO=9100

# --- Actualizaciones Automáticas ---
# URL del repositorio de GitHub para electron-updater
GH_REPO_OWNER=
GH_REPO_NOMBRE=
